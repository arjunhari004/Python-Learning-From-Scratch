    "try:\n",
    "    a = int(input(\"Enter A number:\"))\n",
    "    b = int(input(\"Enter another number: \"))\n",
    "    print(a/b)\n",
    "\n",
    "# try block\n",
    "\n",
    "except ZeroDivisionError:\n",
    "    print(\"Cannot divide By zero\")\n",
    "# except value error\n",
    "except ValueError:\n",
    "    print(\"please enter number only\")"
